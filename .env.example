# Client-side endpoints (Vite). Same-origin paths are served by the
# Cloudflare Pages Functions in /functions. Never put provider API keys here —
# those live in Cloudflare secrets (.dev.vars locally / `wrangler pages secret put`).
# Leave a value empty to keep the clearly labeled preview behavior.
VITE_CONTACT_ENDPOINT=/api/contact
VITE_ANALYTICS_ENDPOINT=/api/track
VITE_AGENT_ENDPOINT=/api/ai/chat
VITE_ADMIN_API_BASE=/api/admin
