{
  "name": "sesemi-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build && wrangler pages dev dist --port 8787",
    "build": "vite build && node scripts/generate-pages.mjs",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute sesemi --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute sesemi --remote --file schema.sql",
    "cf:login": "wrangler login",
    "deploy": "npm run build && wrangler pages deploy",
    "check": "tsc && tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/three": "^0.186.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0"
  }
}
