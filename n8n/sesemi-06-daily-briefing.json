      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let text = String($input.item.json.text || '');\ntext = text.replace(/^```(html)?\\s*/i, '').replace(/\\s*```\\s*$/, '').trim();\nif (text.length > 3800) text = text.slice(0, 3790) + '…';\nconst today = new Date().toISOString().slice(0, 10);\nreturn { json: { summary: text, brief_date: today, created_at: new Date().toISOString() } };"
      },
