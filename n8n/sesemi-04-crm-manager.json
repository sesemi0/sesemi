    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const req = $('When Called By Another Workflow').item.json;\nconst row = $json || {};\nconst email = (req.customer_email || '').trim().toLowerCase();\nconst tx = (req.tx_hash || '').trim();\nif (!email || !tx) {\n  return { json: { ok: false, error: 'missing_email_or_tx_hash' } };\n}\nif (!row.project_code || String(row.customer_email || '').trim().toLowerCase() !== email) {\n  return { json: { ok: false, error: 'not_found' } };\n}\nif (row.status !== 'approved_awaiting_payment') {\n  return { json: { ok: false, error: 'not_awaiting_payment', status: row.status, project_code: row.project_code } };\n}\nreturn { json: { ok: true, row, tx_hash: tx } };"
      },
