    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const req = $('When Called By Another Workflow').item.json;\nconst row = $json || {};\nconst allowedStatus = ['awaiting_owner_approval', 'approved_awaiting_payment', 'rejected', 'paid_in_build', 'delivered'];\nconst allowedPayment = ['unpaid', 'pending_verification', 'paid'];\nif (!row.project_code) {\n  return { json: { ok: false, error: 'not_found', project_code: req.project_code } };\n}\nconst status = req.status ? String(req.status).trim() : row.status;\nconst paymentStatus = req.payment_status ? String(req.payment_status).trim() : row.payment_status;\nif (!allowedStatus.includes(status)) {\n  return { json: { ok: false, error: 'invalid_status', project_code: row.project_code, status: row.status } };\n}\nif (!allowedPayment.includes(paymentStatus)) {\n  return { json: { ok: false, error: 'invalid_payment_status', project_code: row.project_code, status: row.status } };\n}\nreturn { json: { ok: true, row, new_status: status, new_payment_status: paymentStatus, new_owner_note: (req.owner_note !== undefined && req.owner_note !== null && req.owner_note !== '') ? req.owner_note : (row.owner_note || ''), changed_at: new Date().toISOString() } };"
      },
