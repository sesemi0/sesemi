      "id": "f1000017-0000-4000-8000-000000000017",
      "name": "List Recent Tasks",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        496,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst statusFa = { in_progress: '🔄 در جریان', done: '✅ تمام', blocked: '⛔ متوقف', planning: '📋 برنامه‌ریزی', failed: '❌ شکست', active: '▶️ فعال', pending: '⏳ در صف' };\nif (rows.length === 0) {\n  return [{ json: { ok: true, reply_text: 'هنوز مأموریتی ثبت نشده. با /mission <هدف> شروع کن.' } }];\n}\nconst byMission = {};\nfor (const r of rows) {\n  if (!byMission[r.mission_code]) byMission[r.mission_code] = [];\n  byMission[r.mission_code].push(r);\n}\nconst lines = ['📋 تابلوی مأموریت‌ها', ''];\nfor (const [code, tasks] of Object.entries(byMission)) {\n  const done = tasks.filter(t => t.status === 'done').length;\n  lines.push('🎯 ' + code + ' (' + done + '/' + tasks.length + ' ' + (statusFa[tasks[0].status] || tasks[0].status) + ')');\n  for (const t of tasks.sort((a, b) => a.seq - b.seq)) {\n    lines.push('   ' + t.seq + '. ' + t.title + ' [' + (statusFa[t.status] || t.status) + ']');\n  }\n  lines.push('');\n}\nreturn [{ json: { ok: true, reply_text: lines.join('\\n').slice(0, 3800) } }];"
      },
