    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the SESEMI mission planner. Break the GOAL below into 2-6 concrete, ordered tasks for a small automation agency.\n\nReturn ONLY a JSON array. Each element: {\"title\": \"short task title\", \"description\": \"one sentence what to do\", \"assigned_agent\": \"crm|email|web|research|manual\", \"priority\": \"high|medium|low\"}.\nRules: the first task is always analysis/research (assigned_agent: research). The last task is always delivery/QA sign-off (assigned_agent: manual). Keep titles under 60 chars. No markdown, no code fences, no commentary.\n\nGOAL: {{ $json.goal }}",
        "batching": {}
      },
      "id": "f1000005-0000-4000-8000-000000000005",
      "name": "Plan Mission With AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        944,
        144
      ]
    },
    {
