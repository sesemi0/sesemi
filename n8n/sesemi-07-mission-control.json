      "id": "f1000006-0000-4000-8000-000000000006",
      "name": "Mission Planner Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        944,
        304
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.text || '');\nlet m = raw.match(/\\[[\\s\\S]*\\]/);\nif (!m) { throw new Error('AI planner did not return a JSON array: ' + raw.slice(0, 200)); }\nlet plan;\ntry { plan = JSON.parse(m[0]); } catch (e) { throw new Error('Bad JSON from planner: ' + e.message); }\nif (!Array.isArray(plan) || plan.length === 0) { throw new Error('Planner returned an empty plan'); }\nconst allowed = ['crm', 'email', 'web', 'research', 'manual'];\nconst allowedP = ['high', 'medium', 'low'];\nconst missionCode = $('Insert Mission Row').first().json.mission_code;\nconst now = new Date().toISOString();\nconst out = plan.slice(0, 6).map((t, i) => ({\n  mission_code: missionCode,\n  seq: i + 1,\n  title: String(t.title || ('Task ' + (i + 1))).slice(0, 120),\n  description: String(t.description || '').slice(0, 500),\n  assigned_agent: allowed.includes(String(t.assigned_agent)) ? String(t.assigned_agent) : 'manual',\n  priority: allowedP.includes(String(t.priority)) ? String(t.priority) : 'medium',\n  status: i === 0 ? 'active' : 'pending',\n  result_note: '',\n  created_at: now,\n  updated_at: now\n}));\nreturn out.map(j => ({ json: j }));"
      },
