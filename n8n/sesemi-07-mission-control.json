    {
      "parameters": {
        "jsCode": "const mission = $('Get Mission Row').first().json;\nconst tasks = $input.all().map(i => i.json).sort((a, b) => a.seq - b.seq);\nconst statusFa = { in_progress: '🔄 در جریان', done: '✅ تمام', blocked: '⛔ متوقف', planning: '📋 برنامه‌ریزی', failed: '❌ شکست', active: '▶️ فعال', pending: '⏳ در صف' };\nconst lines = ['🎯 ' + mission.mission_code + ' — ' + (statusFa[mission.status] || mission.status), 'هدف: ' + mission.goal, ''];\nfor (const t of tasks) {\n  lines.push(t.seq + '. ' + t.title + ' [' + (statusFa[t.status] || t.status) + ']');\n  if (t.result_note) lines.push('   ↳ ' + t.result_note);\n}\nlines.push('', 'به‌روزرسانی: ' + mission.updated_at);\nreturn [{ json: { ok: true, mission_code: mission.mission_code, status: mission.status, reply_text: lines.join('\\n').slice(0, 3800) } }];"
