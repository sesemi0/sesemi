    {
      "parameters": {
        "jsCode": "const mission = $('Insert Mission Row').first().json;\nconst tasks = $('Parse Task Plan').all().map(i => i.json);\nconst agentFa = { crm: 'مدیریت پروژه', email: 'ایمیل', web: 'وب', research: 'تحقیق', manual: 'انسان' };\nconst lines = ['🎯 مأموریت ' + mission.mission_code + ' ثبت شد', '🎯 هدف: ' + mission.goal, ''];\nfor (const t of tasks) {\n  lines.push(t.seq + '. ' + t.title + ' — ' + (agentFa[t.assigned_agent] || t.assigned_agent) + ' (' + t.priority + ')');\n}\nlines.push('', 'ایجنت‌ها شروع می‌کنند. وضعیت: /tasks');\nreturn [{ json: { ok: true, mission_code: mission.mission_code, reply_text: lines.join('\\n').slice(0, 3500), tasks: JSON.stringify(tasks) } }];"
      },
