    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst trigger = $('Route MC Action').item.json;\nif (rows.length === 0) { return { json: { mission_code: trigger.mission_code, status: 'in_progress', result_summary: '', updated_at: new Date().toISOString(), task_count: 0 } }; }\nconst done = rows.filter(r => r.status === 'done').length;\nconst failed = rows.filter(r => r.status === 'failed').length;\nlet status = 'in_progress';\nif (failed > 0) status = 'blocked';\nif (done === rows.length) status = 'done';\nconst summary = rows.map(r => r.seq + '. ' + r.title + ' → ' + r.status).join(' | ');\nreturn { json: { mission_code: trigger.mission_code, status, result_summary: summary.slice(0, 900), updated_at: new Date().toISOString(), task_count: rows.length, done, failed } };"
      },
